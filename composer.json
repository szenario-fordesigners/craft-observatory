{
	"name": "szenario/craft-umami-is",
	"type": "craft-plugin",
	"license": "proprietary",
	"support": {
		"issues": "https://github.com/szenario-fordesigners/craft-umami-is/issues?state=open",
		"source": "https://github.com/szenario-fordesigners/craft-umami-is",
		"docs": "https://github.com/szenario-fordesigners/craft-umami-is",
		"rss": "https://github.com/szenario-fordesigners/craft-umami-is/releases.atom"
	},
	"require": {
		"php": ">=8.2",
		"craftcms/cms": "^5.0.0"
	},
	"require-dev": {
		"craftcms/ecs": "dev-main",
		"craftcms/phpstan": "dev-main",
		"phpunit/phpunit": "13.1.7"
	},
	"autoload": {
		"psr-4": {
			"szenario\\craftumamiis\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"szenario\\craftumamiis\\tests\\": "tests/"
		}
	},
	"archive": {
		"exclude": [
			"/.agents/**",
			"/.github/**",
			"/.vscode/**",
			"/.idea/**",
			"/frontend/**",
			"/node_modules/**",
			"/ecs.php",
			"/phpstan.neon",
			"/pnpm-lock.yaml",
			"/pnpm-workspace.yaml",
			"/eslint.config.ts",
			"/tsconfig*.json",
			"/vite.config.ts",
			"/package.json",
			"/.prettierrc.json",
			"/.editorconfig",
			"/.gitattributes",
			"/.gitignore",
			"/CHANGELOG.md",
			"/images/**",
			"/skills-lock.json",
			"/renovate.json",
			"/phpunit.xml.dist"
		]
	},
	"extra": {
		"handle": "umami-is",
		"name": "umami",
		"developer": "szenario",
		"documentationUrl": "https://github.com/szenario-fordesigners/craft-umami-is",
		"class": "szenario\\craftumamiis\\UmamiIs"
	},
	"scripts": {
		"check-cs": "ecs check --ansi",
		"fix-cs": "ecs check --ansi --fix",
		"phpstan": "phpstan --memory-limit=1G",
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.2"
		},
		"allow-plugins": {
			"yiisoft/yii2-composer": true,
			"craftcms/plugin-installer": true
		}
	}
}
