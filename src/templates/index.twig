{% extends "_layouts/cp" %}

{% set title = "Umami Analytics" %}
{% set plugin = craft.app.plugins.getPlugin('umami-is') %}
{% do plugin.sync.autoSyncMissingDays() %}
{% set stats = plugin.stats.getDailyStatsReport(30) %}

{% block content %}
	{% do view.registerAssetBundle("szenario\\craftumamiis\\assetbundles\\craftumamiiscp\\CraftUmamiIsCpAsset") %}

	<div id="umami-is-cp-app" data-props="{{ { stats: stats }|json_encode }}"></div>
{% endblock %}
