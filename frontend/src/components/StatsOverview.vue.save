 cat << 'EOF' > /Users/simonwesp/Documents/Projekte/ddev-projects/craft-umami-tester/plugins/craft-umami-is/frontend/src/components/StatsOverview.vue
<script setup lang="ts">
import { computed } from 'vue'

const props = defineProps<{
  stats: {
    bounces: { value: number, change: number },
    pageviews: { value: number, change: number },
    totaltime: { value: number, change: number },
    unique: { value: number, change: number },
    visits: { value: number, change: number }
  } | null,
  loading: boolean
}>()

const formatNumber = (num: number) => {
  if (num >= 1000000) return (num / 1000000).toFixed(1) + 'm'
  if (num >= 1000) return (num / 1000).toFixed(1) + 'k'
  return num.toString()
}

const formatPct = (change: number) => {
    if (change === 0) return '0%'
    return `${change > 0 ? '+' : ''}${Math.round(change)}%`
}

const formatedStats = computed(() => {
    if (!props.stats) return null
    return {
        visitors: {
            value: formatNumber(props.stats.unique.value),
            change: props.stats.unique.change,
            formatChange: formatPct(props.stats.unique.change),
            trend: Math.sign(props.stats.unique.change),
            reverseColor: false
        }
    }
})


</script>

<template>
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
  </div>
</template>
EOF
