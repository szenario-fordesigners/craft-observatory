{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "cd .. && ./frontend/node_modules/.bin/husky frontend/.husky",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "run-p build-only:*",
    "build-only:widget": "BUILD_TARGET=widget vite build",
    "build-only:cp": "BUILD_TARGET=cp vite build",
    "watch": "run-p watch:*",
    "watch:widget": "BUILD_TARGET=widget vite build --watch --mode development",
    "watch:cp": "BUILD_TARGET=cp vite build --watch --mode development",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@unovis/ts": "1.6.5",
    "@unovis/vue": "1.6.5",
    "date-fns": "4.2.1",
    "tailwindcss": "4.3.0",
    "vue": "3.5.34"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "0.1.4",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.12.4",
    "@umami/api-client": "0.80.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.4.0",
    "eslint-plugin-oxlint": "1.66.0",
    "eslint-plugin-vue": "10.9.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.0.5",
    "npm-run-all2": "9.0.1",
    "oxlint": "1.66.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "sass-embedded": "1.99.0",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vite-plugin-vue-devtools": "8.1.2",
    "vue-tsc": "3.3.0"
  },
  "packageManager": "pnpm@11.3.0",
  "lint-staged": {
    "*.{ts,vue,js}": [
      "oxlint --fix -D correctness",
      "eslint --fix --cache"
    ]
  }
}
