# Keeps the installed package down to what Craft actually loads: composer.json,
# LICENSE.md, README.md and src/.
#
# This is the list that decides. Packagist serves GitHub's zipball for this package, and
# GitHub honours export-ignore from here — composer.json's `archive.exclude` never runs for
# that path (it only applies to `composer archive`), so the two must be kept in agreement.
.agents/ export-ignore
.github/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
CHANGELOG.md export-ignore
composer.lock export-ignore
ecs.php export-ignore
frontend/ export-ignore
images/ export-ignore
phpstan.neon export-ignore
phpunit.xml.dist export-ignore
renovate.json export-ignore
skills-lock.json export-ignore
tests/ export-ignore

# Auto-detect text files and perform LF normalization
* text=auto
